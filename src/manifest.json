{
  "manifest_version": 3,
  "name": "ترجمان — ترجمتك فوق الفيديو",
  "short_name": "ترجمان",
  "version": "2.1.0",
  "description": "يحفظ ترجمة الفيديو في ملف SRT لتترجمه بأي نموذج ذكاء اصطناعي من أي لغة إلى لغتك، ثم يعرض ترجمتك فوق الفيديو بضبط التوقيت والتحرير.",
  "minimum_chrome_version": "130",
  "icons": {
    "16": "icons/tarjuman-icon-16.png",
    "32": "icons/tarjuman-icon-32.png",
    "48": "icons/tarjuman-icon-48.png",
    "128": "icons/tarjuman-icon-128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "downloads"],
  "optional_host_permissions": ["https://app-reports.isultantf.workers.dev/*"],
  "background": {
    "service_worker": "background/worker.js"
  },
  "action": {
    "default_title": "ترجمان",
    "default_popup": "pages/popup/index.html",
    "default_icon": { "16": "icons/tarjuman-icon-16.png", "32": "icons/tarjuman-icon-32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["main-world/capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/main.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ui/fonts/subtitle/*.woff2", "ui/fonts/ui/*.woff2"],
      "matches": ["https://www.youtube.com/*"],
      "use_dynamic_url": true
    }
  ]
}
