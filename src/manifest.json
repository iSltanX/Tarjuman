{
  "manifest_version": 3,
  "name": "ترجمان",
  "version": "0.2.0",
  "description": "يستخرج ترجمة يوتيوب الإنجليزية إلى SRT، ويعرض ترجمتك العربية فوق الفيديو بضبط التوقيت والتحرير. كل المعالجة والحفظ محليان.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage"],
  "action": {
    "default_title": "ترجمان",
    "default_popup": "pages/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["main-world/capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/main.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
